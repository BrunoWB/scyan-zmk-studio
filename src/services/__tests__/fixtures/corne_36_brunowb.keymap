#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/ext_power.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/outputs.h>

/ {
    chosen { zmk,matrix-transform = &five_column_transform; };

    keymap {
        compatible = "zmk,keymap";

        Free {
            bindings = <
&kp Q      &kp W    &kp F  &kp P  &kp G  &kp J                &kp L           &kp U      &kp Y                    &kp LALT  &kp A           &kp R
&kp S      &kp T    &kp D  &kp H  &kp N  &kp E                &kp I           &kp O      &kp Z                    &kp X     &kp C           &kp V
&kp COMMA  &kp DOT  &kp B  &kp K  &kp M  &mt RIGHT_ALT SQT    &lt 3 LEFT_GUI  &kp SPACE  &mt LEFT_CONTROL RETURN  &kp BSPC  &kp LEFT_SHIFT  &lt 2 RIGHT_GUI
            >;
        };

        Qwerty {
            bindings = <
&kp Q  &kp W  &kp E  &kp R  &kp T  &kp Y  &kp U  &kp I  &kp O  &kp P  &kp A  &kp S
&kp D  &kp F  &kp G  &kp H  &kp J  &kp K  &kp L  &mt RIGHT_ALT SQT  &kp Z  &kp X  &kp C  &kp V
&kp B  &kp N  &kp M  &kp COMMA  &kp DOT  &kp LALT  &lt 3 LEFT_GUI  &kp SPACE  &mt LEFT_CONTROL RETURN  &kp BSPC  &kp LEFT_SHIFT  &lt 2 RIGHT_GUI
            >;
        };

        RightHold {
            bindings = <
&kp ESC  &kp N1          &kp N2    &kp N3  &kp PRINTSCREEN  &kp DEL     &trans          &kp UP  &trans            &kp RIGHT_ALT  &kp TAB  &kp N4
&kp N5   &kp N6          &kp HOME  &trans  &kp LEFT         &kp DOWN    &kp RIGHT       &trans  &kp BSPC          &kp N7         &kp N8   &kp N9
&kp END  &kp LG(PERIOD)  &trans    &trans  &trans           &trans      &kp LEFT_SHIFT  &kp N0  &kp LEFT_CONTROL  &trans         &mo 4    &trans
            >;
        };

        LeftHold {
            bindings = <
&kp LESS_THAN  &kp GREATER_THAN  &kp CARET       &kp LG(P)        &kp LG(G)  &kp BACKSLASH        &kp LEFT_PARENTHESIS  &kp RIGHT_PARENTHESIS  &kp MINUS      &kp UNDERSCORE     &kp AT       &kp ASTRK
&kp DOLLAR     &kp PIPE          &trans          &kp SLASH        &kp LBKT   &kp RBKT             &kp EXCL              &kp QUESTION           &kp AMPERSAND  &kp TILDE          &kp PERCENT  &kp HASH
&kp SEMI       &kp COLON         &kp LEFT_BRACE  &kp RIGHT_BRACE  &kp GRAVE  &kp DOUBLE_QUOTES    &trans                &trans                 &trans         &kp RIGHT_CONTROL  &kp EQUAL    &kp PLUS
            >;
        };

        SimmHold {
            bindings = <
&bt BT_SEL 0       &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4  &trans    &out OUT_BLE  &out OUT_USB  &bt BT_CLR  &bt BT_CLR_ALL  &studio_unlock  &trans
&trans             &trans        &trans        &trans        &trans        &trans    &trans        &trans        &trans      &trans          &kp A           &ext_power EP_ON
&ext_power EP_TOG  &trans        &trans        &trans        &trans        &trans    &tog 1        &trans        &trans      &trans          &trans          &trans
            >;
        };
    };
};
