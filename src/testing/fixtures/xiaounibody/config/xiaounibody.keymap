#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>

/ {
    keymap {
        compatible = "zmk,keymap";
        default_layer {
            display-name = "Base";
            bindings = <
                &kp Q &kp W &kp E &kp R   &kp U &kp I &kp O &kp P
                &kp A &kp S &kp D &kp F   &kp J &kp K &kp L &kp SEMI
            >;
        };
    };
};
